{
  "name": "dsh-whale-memory",
  "version": "0.6.0",
  "description": "本地长期记忆中枢：记忆节点、召回注入、写入审计；默认本地 SQLite，可选外部记忆服务。",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host",
    "src/shared",
    "src/core",
    "src/core/workers",
    "defaults/README.md",
    "defaults/rules",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "sqlite"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.mjs test/contract/*.test.mjs test/hook/*.test.mjs test/data/*.test.mjs test/worker/*.test.mjs test/lifecycle/*.test.mjs test/sync/*.test.mjs test/client/*.test.mjs test/integration/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:contract": "node --test test/contract/*.test.mjs",
    "test:hook": "node --test test/hook/*.test.mjs",
    "test:data": "node --test test/data/*.test.mjs",
    "test:worker": "node --test test/worker/*.test.mjs",
    "test:lifecycle": "node --test test/lifecycle/*.test.mjs",
    "test:sync": "node --test test/sync/*.test.mjs",
    "test:client": "node --test test/client/*.test.mjs",
    "test:all": "npm run test",
    "check": "node scripts/check.mjs",
    "i18n": "node scripts/i18n-check.mjs",
    "eval": "node scripts/eval.mjs",
    "test:integration": "node --test test/integration/*.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-timer": "^1.2.0"
  }
}
