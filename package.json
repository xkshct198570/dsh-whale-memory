{
  "name": "dsh-whale-memory",
  "version": "0.8.0-beta1",
  "description": "本地长期记忆中枢：记忆节点、召回注入、写入审计；默认本地 SQLite，可选外部记忆服务。",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host",
    "src/shared",
    "src/core",
    "src/core/workers",
    "defaults/README.md",
    "defaults/rules",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.en.md",
    "docs/DETAIL.ja.md",
    "docs/DETAIL.zh.md",
    "docs/MANUAL.zh.md",
    "docs/MIGRATION.md",
    "docs/preview.svg",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "lib/client-src",
    "scripts/build-client.mjs",
    "scripts/lint-size.mjs",
    "scripts/check-deps.mjs",
    "scripts/migrate-wrap-candidates.mjs"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "sqlite"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:contract": "node --test test/contract/*.test.mjs",
    "test:hook": "node --test test/hook/*.test.mjs",
    "test:data": "node --test test/data/*.test.mjs",
    "test:worker": "node --test test/worker/*.test.mjs",
    "test:lifecycle": "node --test test/lifecycle/*.test.mjs",
    "test:sync": "node --test test/sync/*.test.mjs",
    "test:client": "node --test test/client/*.test.mjs",
    "test:all": "npm run test",
    "check": "node scripts/check.mjs",
    "i18n": "node scripts/i18n-check.mjs",
    "eval": "node scripts/eval.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "manual": "node scripts/manual-build.mjs",
    "manual:check": "node scripts/manual-build.mjs --check",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "lint:size": "node scripts/lint-size.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:drift:peer": "node scripts/check-shared-drift.mjs --check --peer ../dsh-persona-hub",
    "pretest": "node scripts/i18n-check.mjs --check && node scripts/manual-build.mjs --check && node scripts/build-client.mjs --check && node scripts/lint-size.mjs && node scripts/check-deps.mjs && node scripts/check-shared-drift.mjs --check && node scripts/compare-baseline.mjs --no-tests",
    "posttest": "node scripts/check-test-counts.mjs",
    "prepack": "node scripts/i18n-check.mjs --check 1>&2 && node scripts/manual-build.mjs --check 1>&2 && node scripts/build-client.mjs --check 1>&2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-error": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-timer": "^1.2.0",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "acorn": "8.14.0"
  },
  "author": "大肥鱼",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkshct198570/dsh-whale-memory.git"
  },
  "homepage": "https://github.com/xkshct198570/dsh-whale-memory#readme",
  "bugs": {
    "url": "https://github.com/xkshct198570/dsh-whale-memory/issues"
  }
}
